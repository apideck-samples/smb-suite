# --------------------------------------------------------------------------
# Apideck — live mode (optional)
#
# When BOTH of these are set the local mock at /api/apideck/* turns into a
# real proxy to https://unify.apideck.com and the demo issues live unified
# API calls (Vault session creation, accounting GETs, etc).
#
# When unset (default), the demo runs against the bundled mock data — useful
# for click-throughs that don't need real provider data.
#
# Get the key + app id from https://platform.apideck.com → Settings.
# --------------------------------------------------------------------------
# APIDECK_API_KEY=apideck_test_...
# APIDECK_APP_ID=...

# Optional default consumer id used when the demo doesn't supply one
# (e.g. cold launches not coming from /session/<jwt>). One Apideck consumer
# can hold many connections — we use this as the synthetic SMB.
# APIDECK_DEFAULT_CONSUMER_ID=northwind-roofing

# --------------------------------------------------------------------------
# Prospect branding (optional)
# --------------------------------------------------------------------------
# Prepend a prospect-branded label to the picker. When set, the picker
# fetches /api/bank-meta?domain=$NEXT_PUBLIC_PROSPECT_DOMAIN and pulls the
# prospect's logo + brand color from their homepage.
# NEXT_PUBLIC_PROSPECT_DOMAIN=acme.example
# NEXT_PUBLIC_PROSPECT_NAME=Acme
